---
import '../styles/global.css';
import { getSession } from '@/lib/session';
import { trackPageView } from '@/lib/analytics';
import { checkSiteUnlockStatus } from '@/lib/entitlement';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface FAQItem {
  question: string;
  answer: string;
}

export interface ArticleMetadata {
  headline: string;
  description?: string;
  datePublished: string;
  dateModified?: string;
  author?: string;
  image?: string;
}

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noIndex?: boolean;
  hideHeader?: boolean;
  hideFooter?: boolean;
  softwareApp?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FAQItem[];
  article?: ArticleMetadata;
  customSchema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description = 'DecayFix connects to Google Search Console, pinpoints decaying blog posts with 20%+ traffic drops, and provides AI playbooks to regain lost rankings.',
  canonical,
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author = 'DecayFix Team',
  noIndex = false,
  hideHeader = false,
  hideFooter = false,
  softwareApp = false,
  breadcrumbs,
  faqs,
  article,
  customSchema,
} = Astro.props;

const session = await getSession(Astro.request);
const isAuthenticated = !!session?.user?.id;
const user = session?.user;

let isUnlocked = false;
if (user?.id || user?.email) {
  const entitlement = await checkSiteUnlockStatus(user.id || '', null, user.email || undefined);
  isUnlocked = entitlement.isUnlocked;
}

const currentPath = Astro.url.pathname;
const isDashboard = currentPath === '/dashboard' || currentPath.startsWith('/dashboard');

// Server-side page view telemetry
await trackPageView(Astro.request, user);

const siteName = 'DecayFix';
const parentBrand = 'SprintLabs.ai';
const siteUrl = 'https://decayfix.sprintlabsai.com';

const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = title.includes('DecayFix') ? title : `${title} | DecayFix by ${parentBrand}`;

const defaultOgImage = `${siteUrl}/og-image.jpg`;
const resolvedOgImage = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`
  : defaultOgImage;

// Structured Data (JSON-LD) Schemas
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'DecayFix',
  legalName: 'SprintLabs.ai',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/favicon.svg`,
  },
  image: defaultOgImage,
  description: 'AI-powered Google Search Console content decay detection and traffic recovery engine.',
  parentOrganization: {
    '@type': 'Organization',
    name: 'SprintLabs.ai',
    url: 'https://sprintlabsai.com',
  },
  sameAs: [
    'https://sprintlabsai.com',
    'https://twitter.com/sprintlabsai',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'DecayFix',
  description: 'Google Search Console Content Decay Detector & AI Recovery Engine',
  publisher: {
    '@id': `${siteUrl}/#organization`,
  },
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: fullTitle,
  description: description,
  inLanguage: 'en-US',
  isPartOf: {
    '@id': `${siteUrl}/#website`,
  },
  datePublished: publishedTime || '2026-01-15T00:00:00Z',
  dateModified: modifiedTime || '2026-09-27T00:00:00Z',
  author: {
    '@type': 'Organization',
    name: author || 'DecayFix Editorial Team',
    url: siteUrl,
  },
};

const schemas: Array<Record<string, any>> = [orgSchema, websiteSchema, webPageSchema];

if (softwareApp) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${siteUrl}/#software`,
    name: 'DecayFix',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: siteUrl,
    description: 'Connect Google Search Console to detect decaying URLs with 20%+ traffic drops and generate AI content refresh playbooks.',
    offers: {
      '@type': 'Offer',
      price: '999',
      priceCurrency: 'INR',
      priceValidUntil: '2027-12-31',
      availability: 'https://schema.org/InStock',
      url: `${siteUrl}/pricing`,
    },
    provider: {
      '@id': `${siteUrl}/#organization`,
    },
  });
}

if (breadcrumbs && breadcrumbs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.url.startsWith('http')
        ? crumb.url
        : `${siteUrl}${crumb.url.startsWith('/') ? '' : '/'}${crumb.url}`,
    })),
  });
}

if (faqs && faqs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}

if (article) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.headline,
    description: article.description || description,
    image: article.image || resolvedOgImage,
    datePublished: article.datePublished,
    dateModified: article.dateModified || article.datePublished,
    author: {
      '@type': 'Organization',
      name: article.author || 'DecayFix Team',
      url: siteUrl,
    },
    publisher: {
      '@id': `${siteUrl}/#organization`,
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
  });
}

if (customSchema) {
  if (Array.isArray(customSchema)) {
    schemas.push(...customSchema);
  } else {
    schemas.push(customSchema);
  }
}
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono with font-display: swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Search Engine Webmaster Verification (Bing & Google) -->
    {process.env.BING_SITE_VERIFICATION ? (
      <meta name="msvalidate.01" content={process.env.BING_SITE_VERIFICATION} />
    ) : (
      <meta name="msvalidate.01" content="C0E783D8982352B880894567B78F046E" />
    )}
    {process.env.GOOGLE_SITE_VERIFICATION ? (
      <meta name="google-site-verification" content={process.env.GOOGLE_SITE_VERIFICATION} />
    ) : (
      <meta name="google-site-verification" content="google16785acc9b8b82c6" />
    )}

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={`${siteName} by ${parentBrand}`} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="en_US" />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@sprintlabsai" />
    <meta name="twitter:creator" content="@sprintlabsai" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <!-- Structured Data (JSON-LD) -->
    {schemas.map((schemaObj) => (
      <script type="application/ld+json" set:html={JSON.stringify(schemaObj)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-100 selection:bg-indigo-500 selection:text-white antialiased font-sans">
    <!-- Top Navigation -->
    {!hideHeader && (
      <header class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur sticky top-0 z-40">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
          <!-- Logo with SprintLabs.ai Parent Branding -->
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-500 to-sky-400 flex items-center justify-center font-black text-white text-lg shadow-sm group-hover:scale-105 transition-transform">
              ⚡
            </div>
            <div class="flex flex-col">
              <div class="flex items-center gap-1.5">
                <span class="font-extrabold text-lg tracking-tight text-white">
                  Decay<span class="text-sky-400">Fix</span>
                </span>
              </div>
              <span class="text-[10px] font-medium text-slate-400 -mt-1 tracking-wider uppercase flex items-center gap-1">
                by <span class="text-sky-400 font-semibold lowercase">sprintlabs.ai</span>
              </span>
            </div>
          </a>

          <nav class="flex items-center gap-3 sm:gap-5 text-sm font-medium text-slate-300">
            <a href="/pricing" class="hover:text-white transition-colors">Pricing</a>
            <a href="/blog" class="hover:text-white transition-colors">Blog</a>
            <a href="/contact" class="hover:text-white transition-colors">Contact</a>
            <a href="/support" class="hover:text-white transition-colors">Support</a>
            
            {!isAuthenticated ? (
              <>
                <a href="/login" class="text-slate-300 hover:text-white transition-colors">Sign In</a>
                <a
                  href="/login"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-sky-500 hover:from-indigo-500 hover:to-sky-400 text-white font-bold text-xs sm:text-sm shadow-md shadow-indigo-600/25 transition-all hover:scale-[1.02] whitespace-nowrap"
                >
                  <span>Connect Search Console</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </>
            ) : !isDashboard ? (
              <>
                <a
                  href="/dashboard"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-sky-500 hover:from-indigo-500 hover:to-sky-400 text-white font-bold text-xs sm:text-sm shadow-md shadow-indigo-600/25 transition-all hover:scale-[1.02] whitespace-nowrap"
                >
                  <span>Go to Dashboard</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </>
            ) : (
              <div class="flex items-center gap-3">
                {isUnlocked ? (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 text-xs font-semibold">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>Pro Monthly</span>
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-900 border border-slate-700 text-slate-300 text-xs font-medium">
                    Free Plan
                  </span>
                )}

                <div class="flex items-center gap-2 pl-2 border-l border-slate-800">
                  <div class="w-7 h-7 rounded-full bg-indigo-600/30 border border-indigo-500/40 text-indigo-300 flex items-center justify-center font-bold text-xs uppercase">
                    {user?.name ? user.name.charAt(0) : user?.email ? user.email.charAt(0) : 'U'}
                  </div>
                  <span class="hidden md:inline-block text-xs text-slate-300 font-medium max-w-[120px] truncate">
                    {user?.name?.split(' ')[0] || user?.email?.split('@')[0] || 'Account'}
                  </span>
                </div>

                <form action="/api/auth/signout" method="POST" class="inline">
                  <button
                    type="submit"
                    class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors text-xs cursor-pointer"
                    title="Sign Out"
                    aria-label="Sign Out"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                  </button>
                </form>
              </div>
            )}
          </nav>
        </div>
      </header>
    )}

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer with SprintLabs.ai Parent Branding -->
    {!hideFooter && (
      <footer class="border-t border-slate-800/80 bg-slate-950 py-12 text-sm text-slate-400">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
          <!-- Logo & Company Branding Matching Header -->
          <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
            <a href="/" class="flex items-center gap-2.5 group">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-sky-400 flex items-center justify-center font-black text-white text-base shadow-sm group-hover:scale-105 transition-transform">
                ⚡
              </div>
              <div class="flex flex-col text-left">
                <span class="font-extrabold text-base tracking-tight text-white leading-tight">
                  Decay<span class="text-sky-400">Fix</span>
                </span>
                <span class="text-[9px] font-medium text-slate-400 tracking-wider uppercase">
                  by <a href="https://sprintlabs.ai" target="_blank" rel="noopener noreferrer" class="text-sky-400 font-semibold lowercase hover:underline">sprintlabs.ai</a>
                </span>
              </div>
            </a>
            <span class="hidden sm:inline text-slate-700">•</span>
            <span class="text-xs text-slate-400">Accelerated Intelligence for Continuous Search Traffic Optimization</span>
          </div>
          
          <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs">
            <a href="/pricing" class="hover:text-slate-200 transition-colors">Pricing</a>
            <a href="/blog" class="hover:text-slate-200 transition-colors">Blog</a>
            <a href="/for/saas" class="hover:text-slate-200 transition-colors">For SaaS</a>
            <a href="/for/ecommerce" class="hover:text-slate-200 transition-colors">For eCommerce</a>
            <a href="/for/agencies" class="hover:text-slate-200 transition-colors">For Agencies</a>
            <a href="/for/publishers" class="hover:text-slate-200 transition-colors">For Publishers</a>
            <a href="/contact" class="hover:text-slate-200 transition-colors">Contact</a>
            <a href="/support" class="hover:text-slate-200 transition-colors">Support</a>
            <a href="/privacy" class="hover:text-slate-200 transition-colors">Privacy</a>
            <a href="/terms" class="hover:text-slate-200 transition-colors">Terms</a>
            <a href="/admin" class="text-slate-500 hover:text-indigo-400 transition-colors font-medium">Admin Portal</a>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>
