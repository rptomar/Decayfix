---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CompetitorScanner from '@/components/home/CompetitorScanner';
import { getSession } from '@/lib/session';

const session = await getSession(Astro.request);
const isAuthenticated = !!session?.user?.id;
const userName = session?.user?.name?.split(' ')[0] || '';
---

<BaseLayout title="Find & Fix Decaying Search Traffic on Your Blog">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-20 pb-28 px-4 sm:px-6">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-900/30 via-slate-950/80 to-slate-950 -z-10 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-950/80 border border-indigo-500/30 text-xs font-semibold text-indigo-300 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
        Built for Bloggers & Content Creators
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight sm:leading-none mb-6">
        Stop losing Google traffic to <span class="bg-gradient-to-r from-sky-400 via-indigo-300 to-rose-400 bg-clip-text text-transparent">content decay</span>.
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Connect your Google Search Console in 10 seconds. DecayFix automatically flags posts with a 20%+ traffic drop and gives you specific Claude AI action plans to revive them.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
        {isAuthenticated ? (
          <a
            href="/dashboard"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-base shadow-xl shadow-indigo-600/30 transition-all hover:scale-105"
          >
            <span>Go to Dashboard</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        ) : (
          <a
            href="/login"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-base shadow-lg shadow-indigo-600/30 transition-all hover:scale-[1.02]"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
            </svg>
            <span>Sign in with Google</span>
          </a>
        )}
        <a
          href="/pricing"
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 font-medium text-base transition-colors"
        >
          View Pricing
        </a>
      </div>

      <p class="text-xs text-slate-500 mt-4">
        {isAuthenticated
          ? `Logged in as ${session?.user?.email || 'verified user'} • Ready to audit`
          : 'Free top 5 preview • No subscription required • Read-only Google Search Console access'}
      </p>
    </div>
  </section>

  <!-- Competitor Scanner Top-of-Funnel Island -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 -mt-10 mb-20">
    <CompetitorScanner client:visible />
  </section>

  <!-- Visual Mockup Showcase (Zero JS Static) -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 -mt-10 mb-28">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/90 shadow-2xl overflow-hidden p-6 sm:p-8 backdrop-blur">
      <div class="flex items-center justify-between pb-6 border-b border-slate-800 mb-6">
        <div class="flex items-center gap-3">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
          </div>
          <span class="text-xs font-mono text-slate-400">DecayFix Analysis • myblog.com</span>
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-semibold">
          <span>8 Decaying Posts Detected</span>
        </div>
      </div>

      <!-- Sample Decaying Item -->
      <div class="space-y-4">
        <div class="p-5 rounded-xl border border-rose-500/30 bg-rose-950/10 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 text-xs font-bold">-68.4% Clicks</span>
              <span class="text-xs text-slate-400 font-mono">/blog/best-seo-tools-2024</span>
            </div>
            <h3 class="text-base font-semibold text-white">Best SEO Tools for Content Creators</h3>
            <p class="text-xs text-slate-300">
              <strong class="text-indigo-300 font-medium">Claude Suggestion:</strong> Update year to current calendar year, refresh screenshots of obsolete dashboards, and add coverage for emerging AI search crawlers.
            </p>
          </div>
          <div class="flex items-center gap-6 text-sm text-right shrink-0">
            <div>
              <div class="text-xs text-slate-500">Baseline</div>
              <div class="font-bold text-slate-200">380 clicks</div>
            </div>
            <div>
              <div class="text-xs text-slate-500">Recent</div>
              <div class="font-bold text-rose-400">120 clicks</div>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-xl border border-slate-800 bg-slate-900 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 text-xs font-bold">-78.5% Clicks</span>
              <span class="text-xs text-slate-400 font-mono">/blog/how-to-start-a-blog</span>
            </div>
            <h3 class="text-base font-semibold text-white">How to Start a WordPress Blog from Scratch</h3>
            <p class="text-xs text-slate-300">
              <strong class="text-indigo-300 font-medium">Claude Suggestion:</strong> High intent shift towards modern headless options. Expand guide with a 3-question FAQ answering current hosting queries.
            </p>
          </div>
          <div class="flex items-center gap-6 text-sm text-right shrink-0">
            <div>
              <div class="text-xs text-slate-500">Baseline</div>
              <div class="font-bold text-slate-200">210 clicks</div>
            </div>
            <div>
              <div class="text-xs text-slate-500">Recent</div>
              <div class="font-bold text-rose-400">45 clicks</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 mb-28">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl font-bold text-white mb-4">How DecayFix Works</h2>
      <p class="text-slate-400">Three straightforward steps to pinpoint decaying content and execute fast updates.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/60 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 font-bold mb-4">
            1
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Connect Search Console</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Sign in with Google. We request read-only access to your Google Search Console properties.
          </p>
        </div>
      </div>

      <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/60 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 font-bold mb-4">
            2
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">20%+ Drop Detection</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            We compare your recent 8-week performance against historical baseline data, identifying URLs losing traction.
          </p>
        </div>
      </div>

      <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/60 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-bold mb-4">
            3
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Claude AI Action Plan</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Get 2–4 sentence tactical advice for every post to update outdated stats, answer new intent, and recover lost rankings.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Inline Pricing Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-28">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl font-bold text-white mb-4">Simple, Fair Pricing</h2>
      <p class="text-slate-400">No recurring subscriptions. Preview your top 5 decaying pages for free or unlock the full report.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Free Preview Card -->
      <div class="rounded-2xl border border-slate-800 bg-slate-900 p-8 flex flex-col justify-between">
        <div>
          <div class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-2">Free Preview</div>
          <div class="text-4xl font-extrabold text-white mb-4">$0</div>
          <p class="text-sm text-slate-400 mb-6">Test the water and fix your biggest traffic leaks.</p>
          <ul class="space-y-3 text-sm text-slate-300">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Connect any Google Search Console site</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Top 5 decaying pages audit</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Claude AI content update suggestions</span>
            </li>
            <li class="flex items-center gap-2 text-slate-500">
              <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              <span>Full site export & pages beyond top 5</span>
            </li>
          </ul>
        </div>
        {isAuthenticated ? (
          <a
            href="/dashboard"
            class="mt-8 block text-center py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm transition-colors"
          >
            Open Dashboard
          </a>
        ) : (
          <a
            href="/login"
            class="mt-8 block text-center py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-medium text-sm transition-colors"
          >
            Start Free Preview
          </a>
        )}
      </div>

      <!-- Paid Unlock Card -->
      <div class="rounded-2xl border-2 border-indigo-500 bg-slate-900/90 p-8 flex flex-col justify-between relative shadow-xl shadow-indigo-500/10">
        <div class="absolute -top-3.5 right-6 px-3 py-1 bg-indigo-500 text-white text-xs font-bold rounded-full uppercase tracking-wider">
          One-Time Payment
        </div>
        <div>
          <div class="text-sm font-semibold text-indigo-400 uppercase tracking-wider mb-2">Full Site Report</div>
          <div class="flex items-baseline gap-2 mb-4">
            <span class="text-4xl font-extrabold text-white">₹999</span>
            <span class="text-sm text-slate-400 font-normal">one-time / site</span>
          </div>
          <p class="text-sm text-slate-400 mb-6">Permanent access to all decaying posts and AI suggestions.</p>
          <ul class="space-y-3 text-sm text-slate-300">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span><strong>100% of all decaying pages</strong> unlocked</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Full Claude AI suggestions for all posts</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Unlimited manual re-analyses</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Email confirmation & permanent dashboard link</span>
            </li>
          </ul>
        </div>
        {isAuthenticated ? (
          <a
            href="/dashboard"
            class="mt-8 block text-center py-3.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-md shadow-indigo-600/30 transition-all hover:scale-[1.02]"
          >
            Go to Dashboard & Unlock
          </a>
        ) : (
          <a
            href="/login"
            class="mt-8 block text-center py-3.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-md shadow-indigo-600/30 transition-all hover:scale-[1.02]"
          >
            Sign In & Unlock Report
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-24">
    <div class="rounded-2xl bg-gradient-to-r from-indigo-900/60 via-slate-900 to-indigo-950/60 border border-indigo-500/20 p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Ready to reclaim your lost search rankings?</h2>
      <p class="text-slate-300 max-w-xl mx-auto mb-8 text-sm sm:text-base">
        Connect your Search Console right now and find out which pages need a fast update before they drop further.
      </p>
      {isAuthenticated ? (
        <a
          href="/dashboard"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white text-slate-950 font-bold text-base hover:bg-slate-100 shadow-xl transition-all hover:scale-105"
        >
          <span>Launch Your Dashboard</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      ) : (
        <a
          href="/login"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white text-slate-950 font-bold text-base hover:bg-slate-100 shadow-xl transition-all hover:scale-105"
        >
          <span>Connect Search Console Free</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      )}
    </div>
  </section>
</BaseLayout>
