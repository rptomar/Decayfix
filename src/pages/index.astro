---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroTypewriter from '@/components/home/HeroTypewriter';
import CompetitorScanner from '@/components/home/CompetitorScanner';
import RoiTrafficCalculator from '@/components/home/RoiTrafficCalculator';
import DecaySimulator from '@/components/home/DecaySimulator';
import AudienceMatrix from '@/components/home/AudienceMatrix';
import { getSession } from '@/lib/session';
import { checkSiteUnlockStatus } from '@/lib/entitlement';

export const prerender = false;

const session = await getSession(Astro.request);
const isAuthenticated = !!session?.user?.id;
const user = session?.user;
const userName = session?.user?.name?.split(' ')[0] || '';

let isUnlocked = false;
if (user?.id || user?.email) {
  const entitlement = await checkSiteUnlockStatus(user.id || '', null, user.email || undefined);
  isUnlocked = entitlement.isUnlocked;
}
---

<BaseLayout title="Stop Losing Google Traffic — 2026 Content Decay Detection & AI Playbooks">
  <!-- 1. Hero Section with Animated Typewriter -->
  <section class="relative overflow-hidden pt-20 pb-24 px-4 sm:px-6">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-900/40 via-slate-950/80 to-slate-950 -z-10 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto text-center">
      {/* Universal Audience Badge */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-950/80 border border-indigo-500/30 text-xs font-semibold text-indigo-300 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
        Built for SaaS, eCommerce, Agencies, Media & Web Businesses
      </div>

      {/* Main Headline */}
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-tight sm:leading-none mb-6">
        Stop losing Google traffic to <span class="bg-gradient-to-r from-sky-400 via-indigo-300 to-rose-400 bg-clip-text text-transparent">content decay</span>.
      </h1>

      {/* Dynamic Animated Typewriter Rotator */}
      <div class="mb-8">
        <HeroTypewriter client:load />
      </div>

      <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Connect your Google Search Console in 10 seconds. DecayFix compares your last 30 days against a 16-month historical baseline, flags pages losing &ge;20% traffic, and provides step-by-step AI playbooks to regain rankings.
      </p>

      {/* Action CTA Buttons */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 max-w-xl mx-auto">
        {isAuthenticated ? (
          <a
            href="/dashboard"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-400 text-white font-bold text-sm sm:text-base shadow-xl shadow-indigo-600/25 transition-all hover:scale-[1.02] whitespace-nowrap"
          >
            <span>Go to Dashboard</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        ) : (
          <a
            href="/login"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-sky-500 hover:from-indigo-500 hover:to-sky-400 text-white font-bold text-sm sm:text-base shadow-xl shadow-indigo-600/30 transition-all hover:scale-[1.02] whitespace-nowrap"
          >
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
            </svg>
            <span>Connect Search Console Free</span>
          </a>
        )}
        <a
          href="/pricing"
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white border border-slate-700/80 font-semibold text-sm sm:text-base transition-all hover:scale-[1.02] whitespace-nowrap shadow-sm"
        >
          View Pricing
        </a>
      </div>

      <p class="text-xs text-slate-500 mt-4">
        {isAuthenticated
          ? `Logged in as ${session?.user?.email || 'verified user'} • Ready to audit`
          : 'Free top 5 preview • No credit card required • Read-only Google Search Console access'}
      </p>
    </div>
  </section>

  <!-- 2. Interactive Competitor Scanner -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 -mt-6 mb-24">
    <CompetitorScanner client:visible />
  </section>

  <!-- 3. Interactive 2026 ROI & Lost Traffic Calculator -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 mb-28">
    <RoiTrafficCalculator client:visible />
  </section>

  <!-- 4. Interactive Before vs After Decay Case Study -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 mb-28">
    <DecaySimulator client:visible />
  </section>

  <!-- 5. Who DecayFix is Built For (Audience Matrix) -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 mb-28">
    <AudienceMatrix client:visible />
  </section>

  <!-- 6. 2026 Comparison: Why Traditional SEO Tools Fail at Content Decay -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 mb-28">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 text-xs font-bold uppercase tracking-wider">
        Industry Benchmark
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
        Why Traditional SEO Tools Miss Content Decay
      </h2>
      <p class="text-slate-400 text-sm">
        Most rank trackers only alert you on keywords you manually type in. DecayFix detects the silent 16-month erosion across your entire site.
      </p>
    </div>

    <div class="rounded-3xl border border-slate-800 bg-slate-900/80 overflow-hidden shadow-2xl backdrop-blur-xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-950/60 text-slate-400">
              <th class="p-5 font-semibold">Capabilities & Value</th>
              <th class="p-5 font-semibold text-slate-500">Traditional Rank Trackers</th>
              <th class="p-5 font-bold text-indigo-400 bg-indigo-950/30 border-l border-r border-indigo-500/20">⚡ DecayFix 2026</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            <tr>
              <td class="p-5 font-medium text-white">16-Month Historical Baseline Comparison</td>
              <td class="p-5 text-slate-500">❌ Only 30–90 days tracked</td>
              <td class="p-5 font-bold text-emerald-400 bg-indigo-950/20 border-l border-r border-indigo-500/20">✓ Full 16-Month True Peak Baseline</td>
            </tr>
            <tr>
              <td class="p-5 font-medium text-white">Year-over-Year (YoY) Seasonality Filter</td>
              <td class="p-5 text-slate-500">❌ Flags normal seasonal drops</td>
              <td class="p-5 font-bold text-emerald-400 bg-indigo-950/20 border-l border-r border-indigo-500/20">✓ Distinguishes Seasonal vs Algorithmic Decay</td>
            </tr>
            <tr>
              <td class="p-5 font-medium text-white">Automated AI Action Playbooks</td>
              <td class="p-5 text-slate-500">❌ Raw charts only, zero recommendations</td>
              <td class="p-5 font-bold text-emerald-400 bg-indigo-950/20 border-l border-r border-indigo-500/20">✓ Tactical Claude AI Refresh Instructions</td>
            </tr>
            <tr>
              <td class="p-5 font-medium text-white">Proactive Monday Morning Alerts</td>
              <td class="p-5 text-slate-500">❌ You must log in & manually dig</td>
              <td class="p-5 font-bold text-emerald-400 bg-indigo-950/20 border-l border-r border-indigo-500/20">✓ Automated Email Digests for 20%+ Drops</td>
            </tr>
            <tr>
              <td class="p-5 font-medium text-white">Setup Friction</td>
              <td class="p-5 text-slate-500">Complex tag managers / tracking scripts</td>
              <td class="p-5 font-bold text-emerald-400 bg-indigo-950/20 border-l border-r border-indigo-500/20">✓ 1-Click Google Search Console Sign-In</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 7. How DecayFix Works Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 mb-28">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl font-bold text-white mb-4">How DecayFix Works in 3 Steps</h2>
      <p class="text-slate-400">Pinpoint decaying content and execute tactical AI updates in under 60 seconds.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="p-6 rounded-2xl border border-slate-800 bg-slate-900/60 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 font-bold mb-4 text-base">
            1
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Connect Search Console</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Sign in with Google. We request read-only access to your Google Search Console properties. Zero tracking code needed on your site.
          </p>
        </div>
      </div>

      <div class="p-6 rounded-2xl border border-slate-800 bg-slate-900/60 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 font-bold mb-4 text-base">
            2
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">20%+ Drop Detection</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Our engine scans up to 16 months of historical traffic and filters out seasonal blips to pinpoint true algorithmic decay.
          </p>
        </div>
      </div>

      <div class="p-6 rounded-2xl border border-slate-800 bg-slate-900/60 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-bold mb-4 text-base">
            3
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">AI Refresh Playbooks</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Get 2–4 sentence tactical advice for every post to update outdated stats, add missing 2026 intent keywords, and recover lost rankings.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Pricing Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-28">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl font-bold text-white mb-4">Simple, Transparent Pricing</h2>
      <p class="text-slate-400">Preview your top 5 decaying pages for free or unlock the continuous monitoring Pro plan.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Free Preview Card -->
      <div class="rounded-2xl border border-slate-800 bg-slate-900 p-8 flex flex-col justify-between relative">
        {isAuthenticated && !isUnlocked && (
          <div class="absolute -top-3 right-6 px-3 py-0.5 bg-slate-800 border border-slate-700 text-slate-300 text-xs font-semibold rounded-full uppercase tracking-wider">
            Your Current Plan
          </div>
        )}
        <div>
          <div class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-2">Free Preview</div>
          <div class="text-4xl font-extrabold text-white mb-4">$0</div>
          <p class="text-sm text-slate-400 mb-6">Test your domain and fix your biggest traffic leaks immediately.</p>
          <ul class="space-y-3 text-sm text-slate-300">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Connect any Google Search Console site</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Top 5 decaying pages audit</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Claude AI content update playbooks</span>
            </li>
            <li class="flex items-center gap-2 text-slate-500">
              <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              <span>Full site export & pages beyond top 5</span>
            </li>
          </ul>
        </div>
        {isAuthenticated ? (
          <a
            href="/dashboard"
            class="mt-8 block text-center py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm transition-colors"
          >
            {isUnlocked ? 'Go to Dashboard' : 'Open Current Dashboard'}
          </a>
        ) : (
          <a
            href="/login"
            class="mt-8 block text-center py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-medium text-sm transition-colors"
          >
            Start Free Preview
          </a>
        )}
      </div>

      <!-- Paid Pro Plan Card -->
      <div class={`rounded-2xl border-2 ${isUnlocked ? 'border-emerald-500/80 bg-slate-900/95 shadow-emerald-500/10' : 'border-indigo-500 bg-slate-900/90 shadow-indigo-500/10'} p-8 flex flex-col justify-between relative shadow-xl`}>
        {isUnlocked ? (
          <div class="absolute -top-3.5 right-6 px-3.5 py-1 bg-emerald-500 text-white text-xs font-bold rounded-full uppercase tracking-wider flex items-center gap-1 shadow-lg shadow-emerald-500/20">
            <span>✓ Current Active Plan</span>
          </div>
        ) : (
          <div class="absolute -top-3.5 right-6 px-3 py-1 bg-indigo-500 text-white text-xs font-bold rounded-full uppercase tracking-wider">
            Monthly Subscription
          </div>
        )}
        <div>
          <div class={`text-sm font-semibold ${isUnlocked ? 'text-emerald-400' : 'text-indigo-400'} uppercase tracking-wider mb-2`}>Pro Monthly Plan</div>
          <div class="flex items-baseline gap-2 mb-4">
            <span class="text-4xl font-extrabold text-white">₹999</span>
            <span class="text-sm text-slate-400 font-normal">/ month</span>
          </div>

          {isUnlocked && (
            <div class="p-3.5 rounded-xl bg-emerald-950/70 border border-emerald-500/40 text-emerald-200 text-xs flex items-center gap-2 mb-4 font-medium">
              <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold shrink-0">✓</span>
              <span>Pro Monthly Active: All posts & AI action plans unlocked for your account.</span>
            </div>
          )}

          <p class="text-sm text-slate-400 mb-6">Continuous monthly access to monitor all decaying posts, traffic drops, and AI suggestions.</p>
          <ul class="space-y-3 text-sm text-slate-300">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span><strong>100% of all decaying pages</strong> unlocked</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Tailored AI recovery action plans for all posts</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Monday Morning automated decay watchdog</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Cancel or pause subscription anytime</span>
            </li>
          </ul>
        </div>
        {isUnlocked ? (
          <a
            href="/dashboard"
            class="mt-8 block text-center py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-lg shadow-emerald-600/30 transition-all hover:scale-[1.02] flex items-center justify-center gap-2"
          >
            <span>✓ Open Unlocked Dashboard</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        ) : isAuthenticated ? (
          <a
            href="/dashboard"
            class="mt-8 block text-center py-3.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-md shadow-indigo-600/30 transition-all hover:scale-[1.02]"
          >
            Upgrade in Dashboard • ₹999/mo
          </a>
        ) : (
          <a
            href="/login"
            class="mt-8 block text-center py-3.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-md shadow-indigo-600/30 transition-all hover:scale-[1.02]"
          >
            Sign In & Subscribe • ₹999/mo
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- 9. Final High-Impact CTA Banner -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-24">
    <div class="rounded-3xl bg-gradient-to-r from-indigo-900/60 via-slate-900 to-indigo-950/60 border border-indigo-500/30 p-8 sm:p-14 text-center relative overflow-hidden shadow-2xl">
      <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white mb-4">
        Ready to Reclaim Your Lost Search Rankings?
      </h2>
      <p class="text-slate-300 max-w-xl mx-auto mb-8 text-sm sm:text-base leading-relaxed">
        Connect your Search Console in 10 seconds. Discover which URLs are silently bleeding clicks and execute AI refresh playbooks before competitors outrank you.
      </p>
      
      {isAuthenticated ? (
        <a
          href="/dashboard"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white text-slate-950 font-bold text-base hover:bg-slate-100 shadow-xl transition-all hover:scale-105"
        >
          <span>Launch Your Dashboard</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      ) : (
        <a
          href="/login"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white text-slate-950 font-bold text-base hover:bg-slate-100 shadow-xl transition-all hover:scale-105"
        >
          <span>Connect Search Console Free</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      )}
    </div>
  </section>
</BaseLayout>
