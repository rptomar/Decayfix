---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = false;

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime()
);

const categories = ['All', 'Informational', 'Guide', 'Commercial', 'Strategy'];
---

<BaseLayout
  title="DecayFix Blog — Content Decay Guides & SEO Strategy"
  description="Master Google Search Console, diagnose content decay, recover lost organic traffic, and optimize for 2026 AI search engines."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-950/80 border border-indigo-500/30 text-xs font-semibold text-indigo-300 mb-6 shadow-sm">
        <span>📚</span> Knowledge Base & Tactical Guides
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Search Traffic Recovery & <span class="bg-gradient-to-r from-sky-400 via-indigo-300 to-rose-400 bg-clip-text text-transparent">Content Decay Hub</span>
      </h1>

      <p class="text-slate-400 text-sm sm:text-base max-w-2xl mx-auto">
        Practical, zero-fluff engineering and SEO strategies to diagnose Google Search Console traffic drops, recover decaying rankings, and optimize for 2026 AI answer engines.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
      {sortedPosts.map((post) => {
        const dateStr = new Date(post.data.datePublished).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        });

        return (
          <article class="p-6 sm:p-8 rounded-2xl border border-slate-800 bg-slate-900/60 hover:border-indigo-500/50 hover:bg-slate-900/80 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-3 text-xs mb-3">
                <span class="px-2.5 py-1 rounded-full bg-indigo-950/80 border border-indigo-500/30 text-indigo-300 font-semibold text-[11px]">
                  {post.data.category}
                </span>
                <time datetime={post.data.datePublished} class="text-slate-500">
                  {dateStr}
                </time>
              </div>

              <h2 class="text-lg sm:text-xl font-bold text-white group-hover:text-sky-300 transition-colors mb-3 leading-snug">
                <a href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed line-clamp-3 mb-6">
                {post.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
              <span class="text-slate-500 font-medium">By {post.data.author}</span>
              <a
                href={`/blog/${post.id}`}
                class="text-sky-400 font-semibold inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform"
              >
                <span>Read Guide</span>
                <span>→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Free Diagnostic CTA Box -->
    <div class="rounded-3xl bg-gradient-to-r from-indigo-950/70 via-slate-900 to-indigo-900/70 border border-indigo-500/30 p-8 sm:p-12 text-center relative overflow-hidden">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
        Detect Which Pages Are Losing Google Traffic Right Now
      </h2>
      <p class="text-slate-300 text-sm max-w-xl mx-auto mb-6">
        Connect your Google Search Console in 10 seconds. DecayFix compares your last 30 days against a 16-month historical baseline to pinpoint decaying URLs with AI recovery playbooks.
      </p>
      <a
        href="/login"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-sky-500 hover:from-indigo-500 hover:to-sky-400 text-white font-bold text-sm shadow-xl shadow-indigo-600/30 transition-all hover:scale-105"
      >
        <span>Start Free Top 5 Audit Preview</span>
        <span>→</span>
      </a>
    </div>
  </div>
</BaseLayout>
