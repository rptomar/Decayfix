---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSession } from '@/lib/session';

export const prerender = false;

const session = await getSession(Astro.request);
if (session?.user) {
  return Astro.redirect('/dashboard');
}

const errorParam = Astro.url.searchParams.get('error');
---

<BaseLayout title="Sign In — DecayFix by SprintLabs.ai" noIndex={true}>
  <div class="min-h-[75vh] flex items-center justify-center px-4 sm:px-6 py-16">
    <div class="max-w-md w-full rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-2xl relative overflow-hidden">
      <!-- Glow background accent -->
      <div class="absolute -top-24 -left-24 w-48 h-48 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-sky-400 font-black text-white text-2xl mx-auto mb-3 shadow-lg shadow-indigo-500/20">
          ⚡
        </div>
        <h1 class="text-2xl font-bold text-white mb-1">Sign in to DecayFix</h1>
        
        <!-- SprintLabs.ai Parent Badge -->
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-800/90 border border-slate-700 text-[11px] font-medium text-slate-300 mb-4">
          <span>by</span>
          <span class="text-sky-400 font-semibold tracking-wide">SprintLabs.ai</span>
        </div>

        <p class="text-sm text-slate-400">
          Connect your Google Search Console account to audit decaying blog posts.
        </p>
      </div>

      {errorParam && (
        <div class="mb-6 p-3 rounded-lg bg-rose-950/60 border border-rose-500/30 text-rose-300 text-xs text-center">
          {errorParam === 'oauth_denied' && 'Google sign-in was cancelled.'}
          {errorParam === 'token_exchange_failed' && 'Failed to exchange authorization code with Google. Please check your credentials.'}
          {errorParam === 'callback_error' && 'An error occurred during authentication. Please try again.'}
          {!['oauth_denied', 'token_exchange_failed', 'callback_error'].includes(errorParam) && 'Authentication failed. Please try again.'}
        </div>
      )}

      <!-- Direct Google OAuth Sign In -->
      <div class="space-y-4">
        <a
          href="/api/auth/google"
          class="w-full flex items-center justify-center gap-3 py-3.5 px-4 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-semibold text-sm shadow-md transition-all hover:scale-[1.01] active:scale-[0.99] cursor-pointer text-center"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
          </svg>
          <span>Continue with Google</span>
        </a>
      </div>

      <!-- Security Notice -->
      <div class="mt-8 pt-6 border-t border-slate-800 text-xs text-slate-400 space-y-2">
        <div class="flex items-center gap-2 text-slate-300 font-medium">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          <span>Read-only permissions</span>
        </div>
        <p>
          We only request <code class="text-[11px] text-sky-400">webmasters.readonly</code> to view your search analytics. We cannot change your site or settings.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
