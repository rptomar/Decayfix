---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pricing — Transparent, No-Subscription Report"
  description="DecayFix pricing: Free preview for your top 5 decaying blog posts, or one-time payment to permanently unlock all decaying URLs and Claude AI recommendations."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-20">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h1 class="text-4xl font-extrabold text-white mb-4">Transparent Pricing for Bloggers</h1>
      <p class="text-slate-300 text-lg">
        No monthly recurring bills. Pay once when you need a comprehensive content refresh audit.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
      <!-- Free Preview Tier -->
      <div class="rounded-2xl border border-slate-800 bg-slate-900 p-8 flex flex-col justify-between">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Free Tier</div>
          <div class="text-4xl font-black text-white mb-2">$0</div>
          <div class="text-xs text-slate-400 mb-6">Always free for testing</div>
          
          <p class="text-sm text-slate-300 mb-6">
            Instant diagnostic preview of your site's most urgent traffic decay problems.
          </p>

          <ul class="space-y-3.5 text-sm text-slate-300">
            <li class="flex items-center gap-3">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Connect Google Search Console</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>16-month historical baseline comparison</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Top 5 decaying posts with full metrics</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Claude AI content update action plans</span>
            </li>
            <li class="flex items-center gap-3 text-slate-500">
              <span>✕</span>
              <span>Posts beyond top 5 are locked</span>
            </li>
          </ul>
        </div>

        <a
          href="/login"
          class="mt-8 block text-center py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-medium text-sm transition-colors"
        >
          Sign in Free
        </a>
      </div>

      <!-- One-time Paid Unlock -->
      <div class="rounded-2xl border-2 border-indigo-500 bg-slate-900 p-8 flex flex-col justify-between relative shadow-xl shadow-indigo-500/10">
        <div class="absolute -top-3 right-6 px-3 py-0.5 bg-indigo-500 text-white text-xs font-bold rounded-full uppercase tracking-wider">
          Best Value
        </div>

        <div>
          <div class="text-xs font-semibold text-indigo-400 uppercase tracking-wider mb-2">Full Site Report</div>
          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-4xl font-black text-white">₹999</span>
            <span class="text-xs text-slate-400">one-time / site</span>
          </div>
          <div class="text-xs text-indigo-300 mb-6">Lifetime access for this website</div>

          <p class="text-sm text-slate-300 mb-6">
            Unlock every single decaying article across your entire blog and get tailored AI instructions.
          </p>

          <ul class="space-y-3.5 text-sm text-slate-300">
            <li class="flex items-center gap-3">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>100% of all decaying posts</strong> unlocked</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Full traffic drop numbers & severity scores</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>AI recommendations for every decaying URL</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Unlimited manual re-analyses anytime</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Permanent report access in dashboard</span>
            </li>
          </ul>
        </div>

        <a
          href="/login"
          class="mt-8 block text-center py-3.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-md shadow-indigo-600/30 transition-all hover:scale-[1.02]"
        >
          Get Full Site Unlock
        </a>
      </div>
    </div>

    <!-- FAQ -->
    <div class="border-t border-slate-800 pt-16">
      <h2 class="text-2xl font-bold text-white mb-8 text-center">Frequently Asked Questions</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm">
        <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/50">
          <h3 class="font-semibold text-white mb-2">Is this a recurring subscription?</h3>
          <p class="text-slate-400 leading-relaxed">
            No! DecayFix v1 is strictly a one-time purchase per site report. You will never be billed automatically on a recurring monthly or annual basis.
          </p>
        </div>
        <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/50">
          <h3 class="font-semibold text-white mb-2">How does DecayFix access my Search Console?</h3>
          <p class="text-slate-400 leading-relaxed">
            When you sign in with Google, we request the official read-only scope (<code class="text-xs text-sky-400 bg-slate-800 px-1 py-0.5 rounded">webmasters.readonly</code>). We cannot modify your site or settings.
          </p>
        </div>
        <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/50">
          <h3 class="font-semibold text-white mb-2">What is the 20% decay threshold?</h3>
          <p class="text-slate-400 leading-relaxed">
            We compare your recent 8-week period against its previous 8-week baseline. Any post that suffered a 20% or greater decline in clicks or impressions is flagged.
          </p>
        </div>
        <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/50">
          <h3 class="font-semibold text-white mb-2">Can I re-analyze my site later?</h3>
          <p class="text-slate-400 leading-relaxed">
            Yes! Once you unlock your site, you can click "Analyze my site" whenever you want to pull fresh numbers without paying again.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
